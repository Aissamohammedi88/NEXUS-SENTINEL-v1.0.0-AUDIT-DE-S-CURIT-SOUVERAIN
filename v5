set -euo pipefail

# ──────────────────────────────────────────────────────────────────────────
# CONFIGURATION
# ──────────────────────────────────────────────────────────────────────────

readonly SCRIPT_NAME="nexus_sentinel.py"
readonly SCRIPT_URL="https://github.com/aissa-mohammedi/nexus-sentinel/raw/main/nexus_sentinel.py"
readonly DEFAULT_PORT="${SENTINEL_PORT:-9992}"
readonly PID_FILE="/tmp/nexus_sentinel.pid"
readonly LOG_FILE="/tmp/nexus_sentinel.log"
readonly LOCK_FILE="/tmp/nexus_sentinel.lock"

# Couleurs pour l'affichage
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly BLUE='\033[0;34m'
readonly CYAN='\033[0;36m'
readonly RESET='\033[0m'

# ──────────────────────────────────────────────────────────────────────────
# FONCTIONS UTILITAIRES
# ──────────────────────────────────────────────────────────────────────────

log_info() {
    echo -e "${BLUE}[INFO]${RESET} $1"
}

log_success() {
    echo -e "${GREEN}[OK]${RESET} $1"
}

log_warn() {
    echo -e "${YELLOW}[WARN]${RESET} $1"
}

log_error() {
    echo -e "${RED}[ERREUR]${RESET} $1" >&2
}

print_banner() {
    echo ""
    echo "╔══════════════════════════════════════════════════════════════════╗"
    echo "║           NEXUS SENTINEL · Secure Audit Launcher               ║"
    echo "╠══════════════════════════════════════════════════════════════════╣"
    echo "║  Auteur : Aissa Mohammedi (DGK)                               ║"
    echo "║  Licence : NEXUS-OPEN-3.0                                     ║"
    echo "╚══════════════════════════════════════════════════════════════════╝"
    echo ""
}

# ──────────────────────────────────────────────────────────────────────────
# VÉRIFICATIONS PRÉALABLES
# ──────────────────────────────────────────────────────────────────────────

check_python() {
    if command -v python3 &>/dev/null; then
        PYTHON_BIN="python3"
        local version
        version=$("${PYTHON_BIN}" --version 2>&1 | cut -d' ' -f2)
        log_success "Python trouvé: ${version}"
        
        # Vérifier version minimale (3.8)
        local major minor
        major=$(echo "$version" | cut -d. -f1)
        minor=$(echo "$version" | cut -d. -f2)
        
        if [[ "$major" -lt 3 ]] || ([[ "$major" -eq 3 ]] && [[ "$minor" -lt 8 ]]); then
            log_error "Python 3.8+ requis. Version actuelle: ${version}"
            exit 1
        fi
        return 0
    elif command -v python &>/dev/null; then
        PYTHON_BIN="python"
        log_success "Python trouvé (commande 'python')"
        return 0
    else
        log_error "Python non installé. Installez Python 3.8+"
        echo "Ubuntu/Debian: sudo apt install python3 python3-pip"
        echo "macOS: brew install python3"
        echo "Fedora/RHEL: sudo dnf install python3"
        exit 1
    fi
}

check_git() {
    if command -v git &>/dev/null; then
        log_success "Git installé"
        return 0
    else
        log_warn "Git non installé - clonage impossible"
        return 1
    fi
}

check_optional_tools() {
    local tools=("semgrep" "bandit" "trivy")
    local available=0
    
    echo ""
    log_info "Vérification des outils optionnels..."
    
    for tool in "${tools[@]}"; do
        if command -v "$tool" &>/dev/null; then
            local version
            if [[ "$tool" == "trivy" ]]; then
                version=$("$tool" version --format short 2>/dev/null || echo "?")
            elif [[ "$tool" == "semgrep" ]]; then
                version=$("$tool" --version 2>/dev/null | head -1 || echo "?")
            else
                version=$("$tool" --version 2>/dev/null | head -1 || echo "?")
            fi
            log_success "  ✓ ${tool}: ${version}"
            ((available++))
        else
            log_warn "  ✗ ${tool}: non installé (fonctionnalités réduites)"
        fi
    done
    
    echo ""
    log_info "Outils disponibles: ${available}/${#tools[@]}"
}

ensure_script_exists() {
    if [[ ! -f "${SCRIPT_NAME}" ]]; then
        log_info "Script ${SCRIPT_NAME} non trouvé..."
        
        if check_git >/dev/null 2>&1; then
            log_info "Téléchargement depuis GitHub..."
            if curl -sSL "$SCRIPT_URL" -o "$SCRIPT_NAME"; then
                chmod +x "$SCRIPT_NAME"
                log_success "Script téléchargé avec succès"
            else
                log_error "Échec du téléchargement"
                return 1
            fi
        else
            log_error "Impossible de télécharger le script (git requis)"
            return 1
        fi
    else
        log_success "Script local trouvé: ${SCRIPT_NAME}"
    fi
}

# ──────────────────────────────────────────────────────────────────────────
# GESTION DU PORT ET FIREWALL
# ──────────────────────────────────────────────────────────────────────────

check_port_available() {
    local port=$1
    
    if lsof -Pi ":${port}" -sTCP:LISTEN -t >/dev/null 2>&1; then
        log_warn "Le port ${port} est déjà utilisé"
        
        # Essayer de trouver le processus
        local pid
        pid=$(lsof -ti ":${port}" 2>/dev/null | head -1)
        if [[ -n "$pid" ]]; then
            log_info "PID occupant le port: ${pid}"
            log_info "Options:"
            echo "  1. Arrêter le processus: sudo kill ${pid}"
            echo "  2. Utiliser un autre port: export SENTINEL_PORT=XXXX && ./launcher.sh"
            echo "  3. Tuer et reprendre: ./launcher.sh --kill-old"
        fi
        return 1
    fi
    
    return 0
}

configure_firewall() {
    local port=$1
    local configured=false
    
    log_info "Configuration du firewall..."
    
    # UFW (Ubuntu/Debian)
    if command -v ufw &>/dev/null; then
        if ufw status 2>/dev/null | grep -q "Status: active"; then
            if ! ufw status 2>/dev/null | grep -q "${port}/tcp"; then
                log_info "Ajout règle UFW pour port ${port}..."
                if sudo ufw allow "${port}/tcp" 2>/dev/null; then
                    log_success "Port ${port} autorisé dans UFW"
                    configured=true
                else
                    log_warn "Échec configuration UFW (sudo requis)"
                fi
            else
                log_success "Port ${port} déjà autorisé dans UFW"
                configured=true
            fi
        fi
    fi
    
    # firewalld (RHEL/Fedora/CentOS)
    if command -v firewall-cmd &>/dev/null; then
        if firewall-cmd --state 2>/dev/null | grep -q "running"; then
            if ! firewall-cmd --list-ports 2>/dev/null | grep -q "${port}/tcp"; then
                log_info "Ajout règle firewalld pour port ${port}..."
                if sudo firewall-cmd --permanent --add-port="${port}/tcp" 2>/dev/null; then
                    sudo firewall-cmd --reload 2>/dev/null
                    log_success "Port ${port} autorisé dans firewalld"
                    configured=true
                else
                    log_warn "Échec configuration firewalld (sudo requis)"
                fi
            else
                log_success "Port ${port} déjà autorisé dans firewalld"
                configured=true
            fi
        fi
    fi
    
    # iptables (fallback générique)
    if command -v iptables &>/dev/null && [[ "$configured" == false ]]; then
        if sudo iptables -L INPUT -n 2>/dev/null | grep -q "dpt:${port}"; then
            log_success "Port ${port} déjà autorisé dans iptables"
        else
            log_info "Ajout règle iptables pour port ${port}..."
            if sudo iptables -I INPUT -p tcp --dport "${port}" -j ACCEPT 2>/dev/null; then
                log_success "Port ${port} autorisé dans iptables"
                configured=true
            else
                log_warn "Échec configuration iptables (sudo requis)"
            fi
        fi
    fi
    
    if [[ "$configured" == false ]]; then
        log_warn "Aucun firewall détecté ou configuration manuelle requise"
        echo ""
        log_info "Ports ouverts manuellement :"
        echo "  Ubuntu/Debian: sudo ufw allow ${port}"
        echo "  RHEL/Fedora: sudo firewall-cmd --add-port=${port}/tcp --permanent && sudo firewall-cmd --reload"
        echo "  Générique: sudo iptables -I INPUT -p tcp --dport ${port} -j ACCEPT"
    fi
}

# ──────────────────────────────────────────────────────────────────────────
# GESTION DES PROCESSUS
# ──────────────────────────────────────────────────────────────────────────

cleanup() {
    log_info "Arrêt propre..."
    
    # Arrêter le serveur Python
    if [[ -f "${PID_FILE}" ]]; then
        local pid
        pid=$(cat "${PID_FILE}")
        if kill -0 "$pid" 2>/dev/null; then
            log_info "Arrêt processus ${pid}..."
            kill "$pid" 2>/dev/null || true
            sleep 2
            
            # Force kill si nécessaire
            if kill -0 "$pid" 2>/dev/null; then
                log_warn "Force kill..."
                kill -9 "$pid" 2>/dev/null || true
            fi
        fi
        rm -f "${PID_FILE}"
    fi
    
    # Libérer le lock
    rm -f "${LOCK_FILE}"
    
    log_success "Nettoyage terminé"
    exit 0
}

get_running_pid() {
    if [[ -f "${PID_FILE}" ]]; then
        local pid
        pid=$(cat "${PID_FILE}")
        if kill -0 "$pid" 2>/dev/null; then
            echo "$pid"
            return 0
        fi
    fi
    return 1
}

kill_old_instance() {
    local pid
    pid=$(get_running_pid)
    
    if [[ -n "$pid" ]]; then
        log_info "Ancienne instance détectée (PID: ${pid})"
        kill "$pid" 2>/dev/null || true
        sleep 2
        
        if kill -0 "$pid" 2>/dev/null; then
            log_warn "Kill forcé..."
            kill -9 "$pid" 2>/dev/null || true
        fi
        
        rm -f "${PID_FILE}"
        log_success "Ancienne instance arrêtée"
    else
        log_info "Aucune instance en cours d'exécution"
    fi
}

# ──────────────────────────────────────────────────────────────────────────
# DÉMARRAGE
# ──────────────────────────────────────────────────────────────────────────

start_server() {
    local port=$1
    
    print_banner
    
    log_info "Initialisation..."
    
    # Vérifications
    check_python
    check_optional_tools
    ensure_script_exists
    
    # Vérifier port libre
    log_info "Vérification du port ${port}..."
    if ! check_port_available "$port"; then
        exit 1
    fi
    
    # Configurer firewall
    configure_firewall "$port"
    
    # Éviter double lancement
    if [[ -f "${LOCK_FILE}" ]]; then
        local existing_pid
        existing_pid=$(cat "${LOCK_FILE}" 2>/dev/null || echo "")
        if [[ -n "$existing_pid" ]] && kill -0 "$existing_pid" 2>/dev/null; then
            log_error "Instance déjà en cours d'exécution (PID: ${existing_pid})"
            exit 1
        fi
        rm -f "${LOCK_FILE}"
    fi
    
    # Démarrer le serveur
    log_info "Démarrage NEXUS SENTINEL sur le port ${port}..."
    echo $$ > "${LOCK_FILE}"
    
    nohup "${PYTHON_BIN}" "${SCRIPT_NAME}" --port "${port}" > "${LOG_FILE}" 2>&1 &
    local server_pid=$!
    echo "$server_pid" > "${PID_FILE}"
    
    # Attendre le démarrage
    local attempts=0
    local max_attempts=30
    
    log_info "Attente du serveur..."
    while [[ $attempts -lt $max_attempts ]]; do
        if nc -z localhost "${port}" 2>/dev/null; then
            break
        fi
        sleep 1
        ((attempts++))
    done
    
    if [[ $attempts -ge $max_attempts ]]; then
        log_error "Serveur ne répond pas après ${max_attempts}s"
        cat "${LOG_FILE}"
        exit 1
    fi
    
    # Succès
    log_success "=========================================="
    log_success "NEXUS SENTINEL est maintenant en ligne !"
    log_success "=========================================="
    echo ""
    echo "  Local:   http://localhost:${port}/"
    
    # Afficher IP locale si disponible
    local local_ip
    if command -v hostname &>/dev/null; then
        local_ip=$(hostname -I 2>/dev/null | awk '{print $1}' || echo "")
        if [[ -n "$local_ip" ]] && [[ "$local_ip" != "127.0.0.1" ]]; then
            echo "  Réseau:  http://${local_ip}:${port}/"
        fi
    fi
    
    echo ""
    echo "  PID:     $(cat "${PID_FILE}")"
    echo "  Logs:    ${LOG_FILE}"
    echo "  Stop:    ./launcher.sh --stop"
    echo ""
    echo "Ctrl+C pour arrêter"
    echo ""
    
    # Traiter Ctrl+C
    trap cleanup SIGINT SIGTERM
    
    # Garder le script actif
    tail -f "${LOG_FILE}"
}

# ──────────────────────────────────────────────────────────────────────────
# STATUT
# ──────────────────────────────────────────────────────────────────────────

show_status() {
    local pid
    pid=$(get_running_pid)
    
    echo ""
    echo "═══════════════════════════════════════════════════════════"
    echo "              NEXUS SENTINEL STATUS"
    echo "═══════════════════════════════════════════════════════════"
    echo ""
    
    if [[ -n "$pid" ]]; then
        echo "  Statut:        ${GREEN}ACTIF${RESET}"
        echo "  PID:           ${pid}"
        echo "  Port:          ${DEFAULT_PORT}"
        echo "  URL:           http://localhost:${DEFAULT_PORT}/"
        
        if kill -0 "$pid" 2>/dev/null; then
            local uptime
            uptime=$(ps -o etime= -p "$pid" 2>/dev/null | xargs || echo "?")
            echo "  Uptime:        ${uptime}"
        fi
    else
        echo "  Statut:        ${RED}ARRÊTÉ${RESET}"
    fi
    
    echo ""
    echo "═══════════════════════════════════════════════════════════"
    
    # Montrer quelques logs récents si fichier existe
    if [[ -f "${LOG_FILE}" ]]; then
        echo ""
        echo "Derniers logs :"
        echo "───────────────────────────────────────────────────────"
        tail -5 "${LOG_FILE}" 2>/dev/null || echo "(vide)"
    fi
    
    echo ""
}

# ──────────────────────────────────────────────────────────────────────────
# MAIN
# ──────────────────────────────────────────────────────────────────────────

usage() {
    echo ""
    echo "Usage: $0 [commande]"
    echo ""
    echo "Commandes:"
    echo "  (aucun)   Démarrer le serveur"
    echo "  --status  Affiche le statut actuel"
    echo "  --stop    Arrête le serveur en cours"
    echo "  --kill    Arrête toute ancienne instance avant de démarrer"
    echo "  --port    Spécifie un port personnalisé (env: SENTINEL_PORT)"
    echo "  --help    Affiche cet aide"
    echo ""
    echo "Exemples:"
    echo "  $0                          # Démarrer avec port par défaut (${DEFAULT_PORT})"
    echo "  $0 --port 9000              # Démarrer sur port 9000"
    echo "  SENTINEL_PORT=8888 $0       # Démarrer sur port 8888"
    echo "  $0 --status                 # Voir si tourné"
    echo "  $0 --stop                   # Arrêter le serveur"
    echo ""
}

# Parse arguments
case "${1:-}" in
    --status)
        show_status
        exit 0
        ;;
    --stop)
        kill_old_instance
        exit 0
        ;;
    --kill)
        kill_old_instance
        start_server "${DEFAULT_PORT}"
        ;;
    --help|-h)
        usage
        exit 0
        ;;
    --port)
        if [[ -n "${2:-}" ]]; then
            start_server "$2"
        else
            log_error "Port manquant après --port"
            usage
            exit 1
        fi
        ;;
    *)
        start_server "${DEFAULT_PORT}"
        ;;
esac
