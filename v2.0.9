# SECTION 9 · GESTIONNAIRE DE JOBS
# ═══════════════════════════════════════════════════════════════════════════

class JobManager:
def __init__(self):
self.lock = threading.RLock()
self.jobs = {}
self.engine = AuditEngine()

def start(self, target):
job_id = uuid.uuid4().hex[:12]
job = {
"id": job_id,
"target": target,
"started_at": datetime.now().isoformat(),
"progress": 0,
"step": "queued",
"message": "En attente",
"report": None,
"queue": queue.Queue(),
"done": False,
}
with self.lock:
self.jobs[job_id] = job

def worker():
def progress_cb(step, pct, msg):
with self.lock:
job["step"] = step
job["progress"] = pct
job["message"] = msg
try:
job["queue"].put_nowait({
"step": step, "progress": pct, "message": msg,
})
except queue.Full:
pass

try:
report = self.engine.audit(target, progress_cb=progress_cb)
DB_INSTANCE.save(report)
job["report"] = report.to_dict()
except Exception as e:
job["message"] = "Erreur : " + str(e)[:200]
finally:
job["done"] = True
try:
job["queue"].put_nowait({"step": "done",
"progress": 100,
"message": "Terminé"})
except queue.Full:
pass

threading.Thread(target=worker, daemon=True).start()
return job_id

def get(self, job_id):
with self.lock:
return self.jobs.get(job_id)


JOBS = JobManager()


