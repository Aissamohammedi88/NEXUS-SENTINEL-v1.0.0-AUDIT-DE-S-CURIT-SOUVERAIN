def to_sarif(report_dict):
results = []
for f in report_dict.get("findings", []):
sev_map = {"CRITICAL": "error", "HIGH": "error",
"MEDIUM": "warning", "LOW": "note", "INFO": "note"}
# CORRECTION : SARIF exige startLine >= 1
line = max(1, int(f.get("line_number") or 0))
results.append({
"ruleId": f.get("id", "unknown"),
"level": sev_map.get(f.get("severity", "LOW"), "warning"),
"message": {"text": f.get("description", "")},
"locations": [{
"physicalLocation": {
"artifactLocation": {"uri": f.get("file_path", "")},
"region": {"startLine": line},
}
}],
})
return {
"version": "2.1.0",
"$schema": "https://json.schemastore.org/sarif-2.1.0.json",
"runs": [{
"tool": {
"driver": {
"name": "NEXUS-SENTINEL",
"version": VERSION,
"informationUri": "https://github.com/aissa-mohammedi/nexus-sentinel",
}
},
"results": results,
}],
}


