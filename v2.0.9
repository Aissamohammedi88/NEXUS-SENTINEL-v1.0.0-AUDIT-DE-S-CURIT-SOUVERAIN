# SECTION 7 · ORCHESTRATEUR
# ═══════════════════════════════════════════════════════════════════════════

class AuditEngine:
def __init__(self):
self.engines = [
SecretsEngine(),
CodeEngine(),
WorkflowEngine(),
DependencyEngine(),
LicenseEngine(),
ExternalEngine("semgrep"),
ExternalEngine("bandit"),
ExternalEngine("trivy"),
]

def ingest(self, target, job_id):
name = os.path.basename(target.rstrip("/").replace(".git", "")) or "repo"
safe_name = re.sub(r"[^a-zA-Z0-9_\-]", "_", name)[:40]
dst = WORKSPACE / (safe_name + "_" + job_id)
if dst.exists():
shutil.rmtree(dst, ignore_errors=True)

if os.path.isdir(target):
# CORRECTION : copie robuste
shutil.copytree(target, dst, symlinks=True,
ignore=shutil.ignore_patterns(*SKIP_DIRS),
ignore_dangling_symlinks=True)
return dst, {"source_type": "local"}
if target.startswith(("http", "git@", "ssh://")):
try:
r = subprocess.run(
["git", "clone", "--depth", "1", target, str(dst)],
capture_output=True, text=True, timeout=SCAN_TIMEOUT,
)
if r.returncode != 0:
raise RuntimeError(r.stderr[:300])
return dst, {"source_type": "git"}
except FileNotFoundError:
raise RuntimeError("git non installé")
raise ValueError("Cible invalide : " + target)

def walk_files(self, repo_path):
for root, dirs, files in os.walk(repo_path):
dirs[:] = [d for d in dirs if d not in SKIP_DIRS]
for f in files:
fp = Path(root) / f
try:
if fp.stat().st_size > MAX_FILE_SIZE:
continue
except OSError:
continue
ext = fp.suffix.lower()
if ext in CODE_EXT or f in DEP_FILES or f.upper().startswith("LICENSE"):
yield fp

def audit(self, target, progress_cb=None):
report = AuditReport(
id=uuid.uuid4().hex[:12],
target=target,
started_at=datetime.now().isoformat(),
)
t0 = time.time()
repo_path = None
findings = []

try:
if progress_cb:
progress_cb("ingest", 0, "Récupération de la cible")
repo_path, meta = self.ingest(target, report.id)
report.metadata = meta

files = list(self.walk_files(repo_path))
total = len(files) or 1
if progress_cb:
progress_cb("scan", 0, "Scan de {} fichiers".format(total))

for i, fp in enumerate(files, 1):
try:
rel = str(fp.relative_to(repo_path))
content = fp.read_text(encoding="utf-8", errors="ignore")
report.files_scanned += 1
for engine in self.engines:
if not isinstance(engine, ExternalEngine):
try:
findings.extend(engine.scan_file(rel, str(fp), content))
except Exception as e:
report.errors.append("{} {}: {}".format(
engine.name, rel, str(e)[:80]))
except Exception as e:
report.errors.append(str(e)[:100])
if progress_cb and i % 10 == 0:
progress_cb("scan", int(i / total * 80),
"Scanné {}/{}".format(i, total))

if progress_cb:
progress_cb("meta", 85, "Analyse des dépendances (trivy)")
dep_files = []
for root, dirs, files_ in os.walk(repo_path):
dirs[:] = [d for d in dirs if d not in SKIP_DIRS]
for f in files_:
if f in DEP_FILES:
dep_files.append(str(Path(root) / f))
meta_info = {"dep_files": dep_files}
for engine in self.engines:
if isinstance(engine, ExternalEngine):
try:
findings.extend(engine.scan_meta(str(repo_path), meta_info))
except Exception as e:
report.errors.append(str(e)[:100])

if progress_cb:
progress_cb("dedup", 95, "Déduplication")

except Exception as e:
report.errors.append(str(e)[:300])
logger.error(traceback.format_exc())

findings = self._dedup(findings)

sev_order = {"CRITICAL": 5, "HIGH": 4, "MEDIUM": 3,
"LOW": 2, "INFO": 1, "UNKNOWN": 0}
findings.sort(key=lambda x: -sev_order.get(x.severity, 0))

stats = {}
for f in findings:
stats[f.severity] = stats.get(f.severity, 0) + 1

weights = {"CRITICAL": 10, "HIGH": 5, "MEDIUM": 2,
"LOW": 0.5, "INFO": 0.1, "UNKNOWN": 0}
raw = sum(weights.get(f.severity, 0) for f in findings)
risk = min(100.0, math.sqrt(raw) * 5) if raw > 0 else 0.0
if risk >= 75:
level = "CRITICAL"
elif risk >= 50:
level = "HIGH"
elif risk >= 25:
level = "MEDIUM"
elif risk > 0:
level = "LOW"
else:
level = "NONE"

report.findings = findings
report.stats = stats
report.risk_score = risk
report.risk_level = level
report.finished_at = datetime.now().isoformat()
report.duration_s = time.time() - t0
report.status = "done"

if repo_path and report.metadata.get("source_type") == "git":
try:
shutil.rmtree(repo_path, ignore_errors=True)
except Exception:
pass

if progress_cb:
progress_cb("done", 100, "Terminé — {} findings".format(len(findings)))

return report

def _dedup(self, findings):
seen = {}
order = {"CRITICAL": 5, "HIGH": 4, "MEDIUM": 3,
"LOW": 2, "INFO": 1, "UNKNOWN": 0}
for f in findings:
key = (f.file_path, f.line_number, f.category, f.title[:40])
if key not in seen:
seen[key] = f
else:
if order.get(f.severity, 0) > order.get(seen[key].severity, 0):
seen[key] = f
return list(seen.values())


