# SECTION 8 · BASE SQLITE
# ═══════════════════════════════════════════════════════════════════════════

class DB:
def __init__(self, path):
self.path = str(path)
self.lock = threading.RLock()
self._conn = None
self._init()

def _c(self):
if self._conn is None:
self._conn = sqlite3.connect(self.path, check_same_thread=False)
self._conn.execute("PRAGMA journal_mode=WAL")
return self._conn

def _init(self):
with self.lock:
c = self._c()
c.executescript("""
CREATE TABLE IF NOT EXISTS audits (
id TEXT PRIMARY KEY,
target TEXT,
started_at TEXT,
finished_at TEXT,
duration_s REAL,
files_scanned INTEGER,
total_findings INTEGER,
critical INTEGER,
high INTEGER,
medium INTEGER,
low INTEGER,
risk_score REAL,
risk_level TEXT,
status TEXT,
report_json TEXT
);
CREATE INDEX IF NOT EXISTS idx_target ON audits(target);
CREATE INDEX IF NOT EXISTS idx_started ON audits(started_at);
""")
c.commit()

def save(self, report):
with self.lock:
c = self._c()
stats = report.stats or {}
d = report.to_dict()
c.execute(
"""INSERT OR REPLACE INTO audits
(id,target,started_at,finished_at,duration_s,files_scanned,
total_findings,critical,high,medium,low,risk_score,risk_level,
status,report_json)
VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)""",
(report.id, report.target, report.started_at,
report.finished_at, report.duration_s,
report.files_scanned, len(report.findings),
stats.get("CRITICAL", 0), stats.get("HIGH", 0),
stats.get("MEDIUM", 0), stats.get("LOW", 0),
report.risk_score, report.risk_level,
report.status, json.dumps(d, ensure_ascii=False)),
)
c.commit()

def get(self, audit_id):
with self.lock:
c = self._c()
row = c.execute(
"SELECT report_json FROM audits WHERE id = ?",
(audit_id,)
).fetchone()
if row:
return json.loads(row[0])
return None

def list_recent(self, limit=50):
with self.lock:
c = self._c()
rows = c.execute(
"""SELECT id,target,started_at,duration_s,total_findings,
risk_score,risk_level,status
FROM audits ORDER BY started_at DESC LIMIT ?""",
(limit,)
).fetchall()
return [
{"id": r[0], "target": r[1], "started_at": r[2],
"duration_s": r[3], "total_findings": r[4],
"risk_score": r[5], "risk_level": r[6], "status": r[7]}
for r in rows
]


DB_INSTANCE = DB(DB_FILE)


