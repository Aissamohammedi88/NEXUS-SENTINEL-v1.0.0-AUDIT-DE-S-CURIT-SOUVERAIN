class EngineBase:
name = "base"

def scan_file(self, rel_path, abs_path, content):
return []

def scan_meta(self, repo_path, metadata):
return []

def available(self):
return True


class SecretsEngine(EngineBase):
name = "secrets"

def scan_file(self, rel_path, abs_path, content):
findings = []
lines = content.splitlines()
for pid, (pat, sev) in SECRET_PATTERNS.items():
for i, line in enumerate(lines, 1):
m = pat.search(line)
if m:
masked = m.group(0)
if len(masked) > 12:
masked = masked[:6] + "..." + masked[-4:]
findings.append(Finding(
id="SEC-" + pid,
title="Secret possible : " + pid,
severity=sev,
category="SECRETS",
file_path=rel_path,
line_number=i,
code_snippet=masked,
description="Pattern {} détecté.".format(pid),
remediation="Retirer du code source, révoquer le secret, utiliser un vault.",
source_tool="nexus.secrets",
))
for tok in extract_high_entropy_tokens(content):
if any(pat.search(tok) for pat, _ in SECRET_PATTERNS.values()):
continue
idx = content.find(tok)
if idx < 0:
continue
line_no = content[:idx].count("\n") + 1
masked = tok[:6] + "..." + tok[-4:] if len(tok) > 12 else tok
findings.append(Finding(
id="SEC-ENTROPY",
title="Token à haute entropie (secret potentiel)",
severity="MEDIUM",
category="SECRETS",
file_path=rel_path,
line_number=line_no,
code_snippet=masked,
description="Entropie de Shannon {:.2f} bits/char — ressemble à un secret.".format(
shannon_entropy(tok)),
remediation="Vérifier manuellement. Si c'est un secret, révoquer.",
source_tool="nexus.entropy",
))
return findings


