for f in self.findings],
"stats": self.stats,
"risk_score": round(self.risk_score, 2),
"risk_level": self.risk_level,
"errors": self.errors,
"status": self.status,
"metadata": self.metadata,
}


# ═══════════════════════════════════════════════════════════════════════════
# SECTION 5 · DÉTECTION PAR ENTROPIE (Shannon)
# ═══════════════════════════════════════════════════════════════════════════

def shannon_entropy(s):
if not s:
return 0.0
counts = {}
for c in s:
counts[c] = counts.get(c, 0) + 1
n = len(s)
h = 0.0
for c, cnt in counts.items():
p = cnt / n
h -= p * math.log2(p)
return h


def looks_like_secret_entropy(token, min_len=20, threshold=4.2):
if len(token) < min_len:
return False
if token.isdigit():
return False
if token.isalpha() and (token.islower() or token.isupper()):
return False
if re.fullmatch(r"[A-Z_]+", token):
return False
if re.fullmatch(r"[a-z_]+", token):
return False
return shannon_entropy(token) >= threshold


def extract_high_entropy_tokens(content, min_len=20, max_tokens=5):
"""Extrait les tokens à haute entropie qui ressemblent à des secrets."""
# CORRECTION : limiter la taille scannée pour éviter les explosions sur binaire
if len(content) > 500_000:
content = content[:500_000]
tokens = re.findall(r"[A-Za-z0-9+/=_\-]{%d,}" % min_len, content)
hits = []
seen = set()
for tok in tokens:
if tok in seen:
continue
seen.add(tok)
if looks_like_secret_entropy(tok):
hits.append(tok)
if len(hits) >= max_tokens:
break
return hits


