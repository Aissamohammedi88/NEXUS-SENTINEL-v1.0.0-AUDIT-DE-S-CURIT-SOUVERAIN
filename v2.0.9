class Handler(BaseHTTPRequestHandler):
server_version = "NexusSentinel/" + VERSION
protocol_version = "HTTP/1.1"

def log_message(self, *a):
pass

def _send(self, code, body, ctype="text/html; charset=utf-8", extra=None):
if isinstance(body, str):
body = body.encode("utf-8")
try:
self.send_response(code)
self.send_header("Content-Type", ctype)
self.send_header("Content-Length", str(len(body)))
self.send_header("Access-Control-Allow-Origin", "*")
self.send_header("Cache-Control", "no-cache")
if extra:
for k, v in extra.items():
self.send_header(k, v)
self.end_headers()
self.wfile.write(body)
except (BrokenPipeError, ConnectionResetError):
pass

def _json(self, code, obj):
try:
body = json.dumps(obj, ensure_ascii=False, default=str)
except Exception:
body = "{}"
self._send(code, body, "application/json; charset=utf-8")

def _read_json(self):
try:
n = int(self.headers.get("Content-Length", 0))
if n == 0:
return {}
return json.loads(self.rfile.read(n).decode("utf-8"))
except Exception:
return {}

def do_GET(self):
parsed = urllib.parse.urlparse(self.path)
path = parsed.path
parts = [p for p in path.split("/") if p]

if not parts:
return self._send(200, render_html())

if parts[0] == "api":
if len(parts) == 2 and parts[1] == "health":
engines = JOBS.engine.engines
available = sum(1 for e in engines if e.available())
return self._json(200, {
"ok": True,
"version": VERSION,
"author": AUTEUR,
"license": LICENCE,
"engines_total": len(engines),
"engines_available": available,
"engines": [{"name": e.name, "available": e.available()}
for e in engines],
})
if len(parts) == 2 and parts[1] == "audits":
return self._json(200, {"audits": DB_INSTANCE.list_recent(50)})
if len(parts) == 3 and parts[1] == "audit":
d = DB_INSTANCE.get(parts[2])
if d:
return self._json(200, d)
return self._json(404, {"error": "audit introuvable"})
if len(parts) == 4 and parts[1] == "audit":
audit_id = parts[2]
kind = parts[3]
d = DB_INSTANCE.get(audit_id)
if not d:
return self._json(404, {"error": "audit introuvable"})
if kind == "json":
return self._send(
200,
json.dumps(d, indent=2, ensure_ascii=False, default=str),
"application/json; charset=utf-8",
{"Content-Disposition":
'attachment; filename="report_' + audit_id + '.json"'})
if kind == "sarif":
sarif = to_sarif(d)
return self._send(
200,
json.dumps(sarif, indent=2, ensure_ascii=False),
"application/json; charset=utf-8",
{"Content-Disposition":
'attachment; filename="report_' + audit_id + '.sarif"'})
if kind == "md":
return self._send(
200,
self._to_markdown(d),
"text/markdown; charset=utf-8",
{"Content-Disposition":
'attachment; filename="report_' + audit_id + '.md"'})
if len(parts) == 3 and parts[1] == "stream":
return self._stream(parts[2])
return self._json(404, {"error": "not found"})

return self._json(404, {"error": "not found"})

def do_POST(self):
parsed = urllib.parse.urlparse(self.path)
if parsed.path == "/api/audit":
payload = self._read_json()
target = (payload.get("target") or "").strip()
if not target:
return self._json(400, {"error": "target manquant"})
job_id = JOBS.start(target)
return self._json(200, {"job_id": job_id, "target": target})
return self._json(404, {"error": "not found"})

def _stream(self, job_id):
job = JOBS.get(job_id)
if not job:
return self._json(404, {"error": "job introuvable"})
try:
self.send_response(200)
self.send_header("Content-Type", "text/event-stream; charset=utf-8")
self.send_header("Cache-Control", "no-cache, no-transform")
self.send_header("Connection", "keep-alive")
self.send_header("X-Accel-Buffering", "no")
self.end_headers()

while True:
try:
ev = job["queue"].get(timeout=2.0)
data = {"type": "progress", **ev}
if ev.get("step") == "done":
data = {"type": "done", "report_id": job_id}
try:
self.wfile.write(
("data: " + json.dumps(data) + "\n\n").encode()
)
self.wfile.flush()
except (BrokenPipeError, ConnectionResetError):
return
if ev.get("step") == "done":
break
except queue.Empty:
if job["done"]:
try:
self.wfile.write(
("data: " + json.dumps({
"type": "done", "report_id": job_id,
}) + "\n\n").encode()
)
self.wfile.flush()
except Exception:
pass
break
try:
self.wfile.write(b": ping\n\n")
self.wfile.flush()
except Exception:
break
except (BrokenPipeError, ConnectionResetError):
pass
except Exception as e:
logger.debug("sse KO: " + str(e)[:100])

def _to_markdown(self, d):
lines = ["# NEXUS SENTINEL — Rapport d'audit", ""]
lines.append("**Cible** : " + str(d.get("target", "")))
lines.append("**Date** : " + str(d.get("started_at", "")))
lines.append("**Durée** : " + str(d.get("duration_s", 0)) + " s")
lines.append("**Fichiers scannés** : " + str(d.get("files_scanned", 0)))
lines.append("**Findings** : " + str(len(d.get("findings", []))))
lines.append("**Score de risque** : " + str(d.get("risk_score", 0)) +
" (" + str(d.get("risk_level", "")) + ")")
lines.append("")
lines.append("## Répartition")
lines.append("")
lines.append("| Sévérité | Nombre |")
lines.append("|----------|--------|")
for sev, n in (d.get("stats") or {}).items():
lines.append("| " + sev + " | " + str(n) + " |")
lines.append("")
lines.append("## Détail")
lines.append("")
for f in d.get("findings", []):
lines.append("### [" + f.get("severity", "") + "] " + f.get("title", ""))
if f.get("file_path"):
lines.append("- **Fichier** : `" + f["file_path"] + ":" +
str(f.get("line_number", 0)) + "`")
if f.get("category"):
lines.append("- **Catégorie** : " + f["category"])
if f.get("description"):
lines.append("- **Description** : " + f["description"])
if f.get("code_snippet"):
lines.append("```")
lines.append(f["code_snippet"])
lines.append("```")
if f.get("remediation"):
lines.append("- **Remédiation** : " + f["remediation"])
lines.append("")
return "\n".join(lines)


class Server(ThreadingHTTPServer):
daemon_threads = True
allow_reuse_address = True


