class DependencyEngine(EngineBase):
name = "dependencies"

def scan_file(self, rel_path, abs_path, content):
fname = os.path.basename(rel_path)
if fname not in DEP_FILES:
return []
findings = []
if fname == "requirements.txt":
for i, line in enumerate(content.splitlines(), 1):
s = line.strip()
if not s or s.startswith("#"):
continue
if "==" not in s and ">=" not in s and "~=" not in s:
findings.append(Finding(
id="DEP-UNPINNED",
title="Dépendance non pinée",
severity="MEDIUM",
category="DEPENDENCIES",
file_path=rel_path,
line_number=i,
code_snippet=s[:120],
description="Aucune version fixée — risque de supply chain.",
remediation="Fixer la version (==X.Y.Z).",
source_tool="nexus.deps",
))
if fname == "package.json":
try:
data = json.loads(content)
except Exception:
return findings
for section in ("dependencies", "devDependencies"):
deps = data.get(section, {})
for pkg, ver in deps.items():
if ver in ("*", "latest") or ver.startswith("^") or ver.startswith("~"):
findings.append(Finding(
id="DEP-LOOSE",
title="Version de dépendance flottante",
severity="LOW",
category="DEPENDENCIES",
file_path=rel_path,
line_number=0,
code_snippet="{}: {}".format(pkg, ver),
description="Version flottante (^, ~, *).",
remediation="Fixer la version exacte pour la prod.",
source_tool="nexus.deps",
))
return findings


class LicenseEngine(EngineBase):
name = "license"

def scan_file(self, rel_path, abs_path, content):
fname = os.path.basename(rel_path).upper()
if not (fname.startswith("LICENSE") or fname.startswith("COPYING")):
return []
content_low = content.lower()
findings = []
for lic, note in LICENSE_BAD.items():
if lic.lower().replace("-", " ") in content_low or lic.lower() in content_low:
findings.append(Finding(
id="LIC-" + lic.replace(".", "_").replace("-", "_"),
title="Licence : " + lic,
severity="LOW",
category="LICENSE",
file_path=rel_path,
line_number=0,
code_snippet=lic,
description=note,
remediation="Vérifier la compatibilité avec votre usage.",
source_tool="nexus.license",
))
return findings


class ExternalEngine(EngineBase):
def __init__(self, tool):
self.name = "ext." + tool
self.tool = tool

def available(self):
try:
subprocess.run([self.tool, "--version"],
capture_output=True, timeout=5)
return True
except Exception:
return False

def scan_meta(self, repo_path, metadata):
if not self.available():
return []
if self.tool == "semgrep":
return self._semgrep(repo_path)
if self.tool == "bandit":
return self._bandit(repo_path)
if self.tool == "trivy":
return self._trivy(repo_path, metadata.get("dep_files", []))
return []

def _semgrep(self, repo_path):
findings = []
try:
r = subprocess.run(
["semgrep", "scan", "--config=auto", "--json", "--quiet",
"--metrics=off", repo_path],
capture_output=True, text=True, timeout=SCAN_TIMEOUT,
)
if not r.stdout:
return findings
data = json.loads(r.stdout)
for item in data.get("results", [])[:500]:
sev = item.get("extra", {}).get("severity", "INFO").upper()
sev_map = {"ERROR": "HIGH", "WARNING": "MEDIUM", "INFO": "LOW"}
findings.append(Finding(
id="SEM-" + str(item.get("check_id", "?"))[:20],
title=item.get("check_id", "semgrep"),
severity=sev_map.get(sev, "MEDIUM"),
category="SAST",
file_path=item.get("path", ""),
line_number=item.get("start", {}).get("line", 0),
code_snippet=(item.get("extra", {}).get("lines") or "")[:200],
description=item.get("extra", {}).get("message", "")[:300],
source_tool="semgrep",
))
except Exception as e:
logger.debug("semgrep KO: " + str(e)[:80])
return findings

def _bandit(self, repo_path):
findings = []
try:
r = subprocess.run(
["bandit", "-r", repo_path, "-f", "json", "-ll"],
capture_output=True, text=True, timeout=SCAN_TIMEOUT,
)
if not r.stdout:
return findings
data = json.loads(r.stdout)
for item in data.get("results", [])[:500]:
sev = item.get("issue_severity", "LOW").upper()
findings.append(Finding(
id="BAND-" + str(item.get("test_id", "?")),
title=item.get("test_name", "bandit"),
severity=sev,
category="SAST",
file_path=item.get("filename", ""),
line_number=item.get("line_number", 0),
code_snippet=(item.get("code") or "")[:200],
description=item.get("issue_text", "")[:300],
source_tool="bandit",
))
except Exception as e:
logger.debug("bandit KO: " + str(e)[:80])
return findings

def _trivy(self, repo_path, dep_files):
findings = []
try:
r = subprocess.run(
["trivy", "fs", "--format", "json", "--quiet",
"--scanners", "vuln,secret", repo_path],
capture_output=True, text=True, timeout=SCAN_TIMEOUT,
)
if not r.stdout:
return findings
data = json.loads(r.stdout)
for res in data.get("Results", []):
for v in res.get("Vulnerabilities", [])[:200]:
findings.append(Finding(
id="TRV-" + str(v.get("VulnerabilityID", "?")),
title=v.get("Title", "vuln")[:80],
severity=v.get("Severity", "UNKNOWN").upper(),
category="DEPENDENCIES",
file_path=res.get("Target", ""),
line_number=0,
code_snippet="{} {} → {}".format(
v.get("PkgName", ""),
v.get("InstalledVersion", ""),
v.get("FixedVersion", "N/A")),
description=(v.get("Description") or "")[:300],
cve=v.get("VulnerabilityID", ""),
reference=v.get("PrimaryURL", ""),
remediation="Mettre à jour vers {}".format(
v.get("FixedVersion", "N/A")),
source_tool="trivy",
))
except Exception as e:
logger.debug("trivy KO: " + str(e)[:80])
return findings


