async function startAudit(){
const target = document.getElementById('target').value.trim();
if (!target) return;

const btn = document.getElementById('btn');
btn.disabled = true;
btn.textContent = 'Audit…';

document.getElementById('results').innerHTML = '';
document.getElementById('grid').style.display = 'none';
document.getElementById('filters').style.display = 'none';
document.getElementById('actions').style.display = 'none';
document.getElementById('progress').classList.add('on');
setProgress('queued', 0, 'Envoi de la cible…');

try {
const r = await fetch('/api/audit', {
method: 'POST',
headers: {'Content-Type': 'application/json'},
body: JSON.stringify({target: target}),
});
const d = await r.json();
if (!d.job_id){
throw new Error(d.error || 'pas de job_id');
}
watchJob(d.job_id);
} catch(e){
setProgress('error', 0, 'Erreur : ' + e.message);
btn.disabled = false;
btn.textContent = "Lancer l'audit";
}
}

window.startAudit = startAudit;

function setProgress(step, pct, msg){
document.getElementById('pStep').textContent = step;
document.getElementById('pPct').textContent = pct + '%';
document.getElementById('pFill').style.width = pct + '%';
document.getElementById('pMsg').textContent = msg;
}

function watchJob(jobId){
if (currentEventSource){
try { currentEventSource.close(); } catch(e){}
}
const es = new EventSource('/api/stream/' + jobId);
currentEventSource = es;

es.onmessage = function(ev){
try {
const d = JSON.parse(ev.data);
if (d.type === 'progress'){
setProgress(d.step, d.progress, d.message);
} else if (d.type === 'done'){
setProgress('done', 100, 'Terminé');
es.close();
currentEventSource = null;
loadReport(jobId);
} else if (d.type === 'error'){
setProgress('error', 0, d.message);
es.close();
currentEventSource = null;
document.getElementById('btn').disabled = false;
document.getElementById('btn').textContent = "Lancer l'audit";
}
} catch(e){}
};

es.onerror = function(){
es.close();
currentEventSource = null;
loadReport(jobId);
};
}

async function loadReport(jobId){
try {
const r = await fetch('/api/audit/' + jobId);
const d = await r.json();
renderReport(d);
} catch(e){
document.getElementById('results').innerHTML =
'<div class="empty">Erreur chargement : ' + esc(e.message) + '</div>';
} finally {
document.getElementById('btn').disabled = false;
document.getElementById('btn').textContent = "Lancer l'audit";
document.getElementById('progress').classList.remove('on');
loadHistory();
}
}

function renderReport(d){
const stats = d.stats || {};
document.getElementById('sCrit').textContent = stats.CRITICAL || 0;
document.getElementById('sHigh').textContent = stats.HIGH || 0;
document.getElementById('sMed').textContent = stats.MEDIUM || 0;
document.getElementById('sLow').textContent = stats.LOW || 0;
document.getElementById('sRisk').textContent = (d.risk_score || 0).toFixed(1);
document.getElementById('sFiles').textContent = d.files_scanned || 0;
document.getElementById('grid').style.display = 'grid';

document.getElementById('dlJson').href = '/api/audit/' + d.id + '/json';
document.getElementById('dlSarif').href = '/api/audit/' + d.id + '/sarif';
document.getElementById('dlMd').href = '/api/audit/' + d.id + '/md';
document.getElementById('actions').style.display = 'flex';

currentFindings = d.findings || [];
currentFilter = 'all';
document.querySelectorAll('.filter').forEach(x => x.classList.remove('on'));
document.querySelectorAll('.filter')[0].classList.add('on');

document.getElementById('filters').style.display = 'flex';
renderFindings();
}

function renderFindings(){
const el = document.getElementById('results');
let list = currentFindings;
if (currentFilter !== 'all'){
list = list.filter(f => f.severity === currentFilter);
}
if (!list.length){
el.innerHTML = '<div class="empty">Aucun finding dans ce filtre.</div>';
return;
}
el.innerHTML = list.map(f => {
let h = '<div class="finding ' + esc(f.severity) + '">';
h += '<div class="head">';
h += '<span class="sev ' + esc(f.severity) + '">' + esc(f.severity) + '</span>';
h += '<span class="title">' + esc(f.title) + '</span>';
h += '<span class="cat">' + esc(f.category) + '</span>';
h += '</div>';
if (f.file_path){
h += '<div class="loc">' + esc(f.file_path) + ':' + esc(f.line_number) + '</div>';
}
if (f.description){
h += '<div class="desc">' + esc(f.description) + '</div>';
}
if (f.code_snippet){
h += '<div class="snippet">' + esc(f.code_snippet) + '</div>';
}
if (f.remediation){
h += '<div class="fix">' + esc(f.remediation) + '</div>';
}
h += '</div>';
return h;
}).join('');
}

async function loadHistory(){
try {
const r = await fetch('/api/audits');
const d = await r.json();
const audits = d.audits || [];
