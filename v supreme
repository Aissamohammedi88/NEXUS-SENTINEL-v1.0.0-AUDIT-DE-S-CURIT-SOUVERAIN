class Handler(BaseHTTPRequestHandler):
    server_version = f"NexusSentinel/{VERSION}"
    
    def log_message(self, *a): pass
    
    def _send(self, code, body, ctype="text/html; charset=utf-8", extra=None):
        if isinstance(body, str): body = body.encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Access-Control-Allow-Origin", "*")
        if extra:
            for k, v in extra.items(): self.send_header(k, v)
        self.end_headers()
        self.wfile.write(body)
    
    def _json(self, code, obj):
        self._send(code, json.dumps(obj, ensure_ascii=False, default=str), "application/json")
    
    def _read_json(self):
        try:
            n = int(self.headers.get("Content-Length", 0))
            return json.loads(self.rfile.read(n).decode()) if n else {}
        except: return {}
    
    def do_GET(self):
        parsed = urllib.parse.urlparse(self.path)
        path = parsed.path
        parts = [p for p in path.split("/") if p]
        
        if not parts or parts[0] == "index.html":
            from html_template import render_html
            return self._send(200, render_html())
        
        if parts[0] != "api": return self._json(404, {"error": "not found"})
        
        if len(parts) == 2:
            if parts[1] == "health":
                engines = JOBS.engine.engines
                avail = sum(1 for e in engines if e.available())
                return self._json(200, {"ok": True, "version": VERSION, "engines_available": avail})
            if parts[1] == "audits": return self._json(200, {"audits": DB_INSTANCE.list_recent(50)})
        
        if len(parts) == 3 and parts[1] == "audit":
            d = DB_INSTANCE.get(parts[2])
            if not d: return self._json(404, {"error": "introuvable"})
            kind = parts[2].split("/")[-1] if "/" in parts[2] else None
            return self._json(200, d)
        
        if len(parts) >= 4 and parts[1] == "audit":
            audit_id, kind = parts[2], parts[3]
            d = DB_INSTANCE.get(audit_id)
            if not d: return self._json(404, {"error": "introuvable"})
            if kind == "json":
                return self._send(200, json.dumps(d, indent=2, ensure_ascii=False), "application/json",
                    {"Content-Disposition": f'attachment; filename="report_{audit_id}.json"'})
            elif kind == "sarif":
                sarif = {"version": "2.1.0", "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
                        "runs": [{"tool": {"driver": {"name": "NEXUS-SENTINEL", "version": VERSION}},
                                "results": [{"ruleId": f.get("id"), "level": "warning",
                                            "message": {"text": f.get("description")},
                                            "locations": [{"physicalLocation": {
                                                "artifactLocation": {"uri": f.get("file_path")},
                                                "region": {"startLine": max(1, int(f.get("line_number") or 0))}}}]
                                            }] for f in d.get("findings", [])}]}
                return self._send(200, json.dumps(sarif, indent=2), "application/json",
                    {"Content-Disposition": f'attachment; filename="report_{audit_id}.sarif"'})
            elif kind == "md":
                md = f"# Audit {audit_id}\nCible: {d.get('target')}\nFindings: {len(d.get('findings', []))}\n"
                return self._send(200, md, "text/markdown")
        
        if len(parts) == 3 and parts[1] == "stream":
            return self._stream(parts[2])
        
        return self._json(404, {"error": "not found"})
    
    def do_POST(self):
        if self.path == "/api/audit":
            payload = self._read_json()
            target = (payload.get("target") or "").strip()
            if not target: return self._json(400, {"error": "target manquant"})
            job_id = JOBS.start(target)
            return self._json(200, {"job_id": job_id, "target": target})
        return self._json(404, {"error": "not found"})
    
    def _stream(self, job_id):
        job = JOBS.get(job_id)
        if not job: return self._json(404, {"error": "introuvable"})
        try:
            self.send_response(200)
            self.send_header("Content-Type", "text/event-stream; charset=utf-8")
            self.send_header("Cache-Control", "no-cache")
            self.send_header("Connection", "keep-alive")
            self.end_headers()
            while True:
                try:
                    ev = job["queue"].get(timeout=2)
                    data = {"type": "progress", **ev} if ev.get("step") != "done" else {"type": "done"}
                    self.wfile.write(("data: " + json.dumps(data) + "\n\n").encode())
                    self.wfile.flush()
                    if ev.get("step") == "done": break
                except queue.Empty:
                    if job["done"]:
                        self.wfile.write(b"data: {\"type\":\"done\"}\n\n")
                        self.wfile.flush()
                    break
                self.wfile.write(b": ping\n\n")
                self.wfile.flush()
        except: pass

class Server(ThreadingHTTPServer):
    daemon_threads = True
    allow_reuse_address = True

