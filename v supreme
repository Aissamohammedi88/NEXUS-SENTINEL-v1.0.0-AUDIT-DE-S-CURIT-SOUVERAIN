class DB:
    def __init__(self, path):
        self.path, self.lock, self._conn = str(path), threading.RLock(), None
        self._init()
    
    def _c(self):
        if not self._conn:
            self._conn = sqlite3.connect(self.path, check_same_thread=False)
        return self._conn
    
    def _init(self):
        with self.lock:
            c = self._c()
            c.execute("""CREATE TABLE IF NOT EXISTS audits (
                id TEXT PRIMARY KEY, target TEXT, started_at TEXT,
                finished_at TEXT, duration_s REAL, files_scanned INTEGER,
                total_findings INTEGER, risk_score REAL, risk_level TEXT,
                status TEXT, report_json TEXT)""")
            c.commit()
    
    def save(self, report):
        with self.lock:
            c = self._c()
            d = report.to_dict()
            c.execute("""INSERT OR REPLACE INTO audits VALUES (?,?,?,?,?,?,?,?,?,?,?)""",
                (report.id, report.target, report.started_at, report.finished_at,
                 report.duration_s, report.files_scanned, len(report.findings),
                 report.risk_score, report.risk_level, report.status,
                 json.dumps(d, ensure_ascii=False)))
            c.commit()
    
    def get(self, audit_id):
        with self.lock:
            row = self._c().execute("SELECT report_json FROM audits WHERE id=?", (audit_id,)).fetchone()
            return json.loads(row[0]) if row else None
    
    def list_recent(self, limit=50):
        with self.lock:
            rows = self._c().execute("""SELECT id,target,started_at,duration_s,
                total_findings,risk_score,risk_level,status FROM audits 
                ORDER BY started_at DESC LIMIT ?""", (limit,)).fetchall()
            return [{"id": r[0], "target": r[1], "started_at": r[2],
                    "duration_s": r[3], "total_findings": r[4],
                    "risk_score": r[5], "risk_level": r[6], "status": r[7]} for r in rows]

DB_INSTANCE = DB(DB_FILE)

