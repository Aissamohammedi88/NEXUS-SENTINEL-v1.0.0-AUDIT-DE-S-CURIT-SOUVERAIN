def shannon_entropy(s):
    if not s: return 0.0
    counts = {}
    for c in s: counts[c] = counts.get(c, 0) + 1
    n = len(s)
    return sum(-((cnt/n) * math.log2(cnt/n)) for cnt in counts.values())

def extract_high_entropy_tokens(content, min_len=20, max_tokens=5):
    if len(content) > 500_000: content = content[:500_000]
    tokens = re.findall(r"[A-Za-z0-9+/=_\-]{%d,}" % min_len, content)
    hits, seen = [], set()
    for tok in tokens:
        if tok in seen: continue
        seen.add(tok)
        if len(tok) >= min_len and shannon_entropy(tok) >= 4.2:
            hits.append(tok)
            if len(hits) >= max_tokens: break
    return hits

