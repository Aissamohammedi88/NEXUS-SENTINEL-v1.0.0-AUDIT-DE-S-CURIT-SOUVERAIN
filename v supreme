class EngineBase:
    name = "base"
    def scan_file(self, rel_path, abs_path, content): return []
    def scan_meta(self, repo_path, metadata): return []
    def available(self): return True

class SecretsEngine(EngineBase):
    name = "secrets"
    def scan_file(self, rel_path, abs_path, content):
        findings = []
        for i, line in enumerate(content.splitlines(), 1):
            for pid, (pat, sev) in SECRET_PATTERNS.items():
                m = pat.search(line)
                if m:
                    masked = m.group(0)[:6] + "..." + m.group(0)[-4:] if len(m.group(0)) > 12 else m.group(0)
                    findings.append(Finding(
                        id=f"SEC-{pid}", title=f"Secret possible : {pid}",
                        severity=sev, category="SECRETS", file_path=rel_path,
                        line_number=i, code_snippet=masked,
                        description=f"Pattern {pid} détecté.",
                        remediation="Révoquer le secret, utiliser un vault.",
                        source_tool="nexus.secrets",
                    ))
        for tok in extract_high_entropy_tokens(content):
            idx = content.find(tok)
            findings.append(Finding(
                id="SEC-ENTROPY", title="Token haute entropie",
                severity="MEDIUM", category="SECRETS", file_path=rel_path,
                line_number=content[:idx].count("\n") + 1,
                code_snippet=tok[:6] + "..." + tok[-4:],
                description=f"Entropie: {shannon_entropy(tok):.2f} bits/char",
                remediation="Vérifier manuellement.",
                source_tool="nexus.entropy",
            ))
        return findings

