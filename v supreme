class AuditEngine:
    def __init__(self):
        self.engines = [
            SecretsEngine(), CodeEngine(), WorkflowEngine(),
            DependencyEngine(), LicenseEngine(),
        ]

    def ingest(self, target, job_id):
        name = os.path.basename(target.rstrip("/").replace(".git", "")) or "repo"
        safe_name = re.sub(r"[^a-zA-Z0-9_\-]", "_", name)[:40]
        dst = WORKSPACE / (safe_name + "_" + job_id)
        if dst.exists(): shutil.rmtree(dst, ignore_errors=True)
        if os.path.isdir(target):
            shutil.copytree(target, dst, symlinks=True,
                          ignore=shutil.ignore_patterns(*SKIP_DIRS))
            return dst, {"source_type": "local"}
        raise ValueError(f"Cible invalide: {target}")

    def walk_files(self, repo_path):
        for root, dirs, files in os.walk(repo_path):
            dirs[:] = [d for d in dirs if d not in SKIP_DIRS]
            for f in files:
                fp = Path(root) / f
                try:
                    if fp.stat().st_size > MAX_FILE_SIZE: continue
                except OSError: continue
                ext = fp.suffix.lower()
                if ext in CODE_EXT or f in DEP_FILES or "LICENSE" in f.upper():
                    yield fp

    def audit(self, target, progress_cb=None):
        report = AuditReport(id=uuid.uuid4().hex[:12], target=target,
                            started_at=datetime.now().isoformat())
        t0 = time.time()
        findings = []
        try:
            repo_path, meta = self.ingest(target, report.id)
            report.metadata = meta
            files = list(self.walk_files(repo_path))
            total = len(files) or 1
            for i, fp in enumerate(files, 1):
                try:
                    rel = str(fp.relative_to(repo_path))
                    content = fp.read_text(encoding="utf-8", errors="ignore")
                    report.files_scanned += 1
                    for engine in self.engines:
                        findings.extend(engine.scan_file(rel, str(fp), content))
                except Exception as e:
                    report.errors.append(str(e)[:100])
                if progress_cb and i % 10 == 0:
                    progress_cb("scan", int(i/total*80), f"Scanné {i}/{total}")
        except Exception as e:
            report.errors.append(str(e)[:300])
        
        findings = self._dedup(findings)
        sev_order = {"CRITICAL": 5, "HIGH": 4, "MEDIUM": 3, "LOW": 2}
        findings.sort(key=lambda x: -sev_order.get(x.severity, 0))
        stats = {}
        for f in findings: stats[f.severity] = stats.get(f.severity, 0) + 1
        weights = {"CRITICAL": 10, "HIGH": 5, "MEDIUM": 2, "LOW": 0.5}
        raw = sum(weights.get(f.severity, 0) for f in findings)
        risk = min(100.0, math.sqrt(raw) * 5) if raw > 0 else 0.0
        report.findings, report.stats, report.risk_score = findings, stats, risk
        report.risk_level = "CRITICAL" if risk >= 75 else "HIGH" if risk >= 50 else "MEDIUM" if risk >= 25 else "LOW" if risk > 0 else "NONE"
        report.finished_at, report.duration_s, report.status = datetime.now().isoformat(), time.time()-t0, "done"
        return report

    def _dedup(self, findings):
        seen, order = {}, {"CRITICAL": 5, "HIGH": 4, "MEDIUM": 3, "LOW": 2}
        for f in findings:
            key = (f.file_path, f.line_number, f.category, f.title[:40])
            if key not in seen or order.get(f.severity, 0) > order.get(seen[key].severity, 0):
                seen[key] = f
        return list(seen.values())

