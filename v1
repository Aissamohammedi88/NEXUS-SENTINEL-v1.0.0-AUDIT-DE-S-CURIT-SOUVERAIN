class Ingestor:
"""Clonage et analyse de la structure du dépôt."""

def __init__(self):
self.workspace = SentinelConfig.WORKSPACE_DIR

def ingest(self, target: str) -> Tuple[str, Dict[str, Any]]:
"""
Clone le dépôt ou analyse le dossier local.
Retourne (chemin_local, métadonnées).
"""
logger.info(f"📥 Ingestion de : {target}")

# Nettoyage du workspace
repo_name = self._get_repo_name(target)
local_path = os.path.join(self.workspace, repo_name)

if os.path.exists(local_path):
logger.info(f"Suppression de l'ancien workspace : {local_path}")
shutil.rmtree(local_path, ignore_errors=True)

# Détection : local ou distant
if os.path.isdir(target):
logger.info(f"Dossier local détecté : {target}")
shutil.copytree(target, local_path)
elif target.startswith(("http://", "https://", "git@")):
logger.info(f"Dépôt distant détecté : {target}")
self._clone_repo(target, local_path)
else:
raise ValueError(f"Target invalide : {target}")

# Analyse de la structure
metadata = self._analyze_structure(local_path)

logger.info(f"✅ Ingestion terminée : {local_path}")
return local_path, metadata

def _get_repo_name(self, target: str) -> str:
"""Extrait le nom du dépôt."""
if os.path.isdir(target):
return os.path.basename(os.path.normpath(target))

# URL GitHub : https://github.com/user/repo.git
parts = target.rstrip('/').split('/')
name = parts[-1]
if name.endswith('.git'):
name = name[:-4]
return name or "unknown_repo"

def _clone_repo(self, url: str, dest: str):
"""Clone le dépôt."""
try:
cmd = ["git", "clone", "--depth", "1", url, dest]
logger.info(f"Exécution : {' '.join(cmd)}")

result = subprocess.run(
cmd, capture_output=True, text=True, timeout=SentinelConfig.TIMEOUT
)

if result.returncode != 0:
raise RuntimeError(f"Échec du clonage : {result.stderr}")

logger.info("✅ Clonage réussi.")
except FileNotFoundError:
raise RuntimeError("Git n'est pas installé.")
except subprocess.TimeoutExpired:
raise RuntimeError(f"Timeout lors du clonage ({SentinelConfig.TIMEOUT}s)")

def _analyze_structure(self, path: str) -> Dict[str, Any]:
"""Analyse la structure du projet."""
logger.info("🔍 Analyse de la structure...")

stats = {
"total_files": 0,
"code_files": 0,
"languages": {},
"workflows": [],
"total_size": 0,
"has_dependencies": False,
"dependency_files": []
}

for root, dirs, files in os.walk(path):
# Ignorer les dossiers inutiles
dirs[:] = [d for d in dirs if d not in [
'.git', 'node_modules', 'venv', '__pycache__', 'dist', 'build',
'.tox', 'target', 'vendor'
]]

for file in files:
file_path = os.path.join(root, file)
ext = os.path.splitext(file)[1].lower()

stats["total_files"] += 1

try:
stats["total_size"] += os.path.getsize(file_path)
except OSError:
pass

if ext in SentinelConfig.CODE_EXTENSIONS:
stats["code_files"] += 1
lang = SentinelConfig.CODE_EXTENSIONS[ext]
stats["languages"][lang] = stats["languages"].get(lang, 0) + 1

# Workflows GitHub Actions
if ".github/workflows" in file_path and ext in ('.yml', '.yaml'):
stats["workflows"].append(file_path)

# Fichiers de dépendances
if file in ['requirements.txt', 'package.json', 'Pipfile', 'poetry.lock',
'Gemfile', 'go.mod', 'pom.xml', 'Cargo.toml']:
stats["has_dependencies"] = True
stats["dependency_files"].append(file_path)

logger.info(f"📊 {stats['code_files']} fichiers de code détectés")
logger.info(f"🔧 Langages : {list(stats['languages'].keys())}")
logger.info(f"⚙️ {len(stats['workflows'])} workflows GitHub Actions")
logger.info(f"📦 {len(stats['dependency_files'])} fichiers de dépendances")

return stats

