class CrossChecker:
"""Corrèle et déduplique les findings de tous les moteurs."""

def deduplicate(self, findings: List[Finding]) -> List[Finding]:
"""
Déduplique les findings basés sur (fichier, ligne, catégorie).
Priorise les findings avec la sévérité la plus haute.
"""
logger.info(f"🔄 Déduplication de {len(findings)} findings...")

# Grouper par clé de déduplication
groups: Dict[str, List[Finding]] = {}

for finding in findings:
key = f"{finding.file_path}:{finding.line_number}:{finding.category}"
if key not in groups:
groups[key] = []
groups[key].append(finding)

# Sélectionner le finding le plus sévère de chaque groupe
severity_order = {"CRITICAL": 5, "HIGH": 4, "MEDIUM": 3, "LOW": 2, "INFO": 1, "UNKNOWN": 0}

deduplicated = []
for key, group in groups.items():
# Trier par sévérité décroissante
group.sort(key=lambda f: severity_order.get(f.severity, 0), reverse=True)
deduplicated.append(group[0])

if len(group) > 1:
logger.debug(f"Dédupliqué {len(group)} findings en 1 pour {key}")

logger.info(f"✅ {len(findings)} → {len(deduplicated)} findings après déduplication")
return deduplicated

def prioritize(self, findings: List[Finding]) -> List[Finding]:
"""
Priorise les findings par sévérité, puis par catégorie.
"""
severity_order = {"CRITICAL": 5, "HIGH": 4, "MEDIUM": 3, "LOW": 2, "INFO": 1, "UNKNOWN": 0}
category_order = {"SECRET": 5, "WORKFLOW": 4, "SAST": 3, "DEPENDENCY": 2, "CONFIG": 1}

return sorted(
findings,
key=lambda f: (
-severity_order.get(f.severity, 0),
-category_order.get(f.category, 0),
f.file_path
)
)

