class ReportGenerator:
"""Génère les rapports dans différents formats."""

def __init__(self):
pass

def generate_json(self, report: AuditReport, output_path: str):
"""Génère un rapport JSON."""
with open(output_path, 'w', encoding='utf-8') as f:
json.dump(report.to_dict(), f, indent=2, ensure_ascii=False)
logger.info(f"📄 Rapport JSON : {output_path}")

def generate_markdown(self, report: AuditReport, output_path: str):
"""Génère un rapport Markdown structuré."""
lines = []

# En-tête
lines.append(f"# 🛡️ Rapport d'Audit NEXUS-SENTINEL\n")
lines.append(f"**Cible :** `{report.target}`\n")
lines.append(f"**Date :** {report.timestamp}\n")
lines.append(f"**Durée :** {report.duration:.2f}s\n")
lines.append(f"**Fichiers analysés :** {report.files_analyzed}\n")
lines.append(f"**Total findings :** {len(report.findings)}\n")
lines.append("\n---\n")

# Statistiques
lines.append("## 📊 Statistiques\n")
lines.append("| Sévérité | Nombre |")
lines.append("|----------|--------|")
for severity in ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"]:
count = report.stats.get(severity, 0)
if count > 0:
lines.append(f"| {severity} | {count} |")
lines.append("\n---\n")

# Findings par catégorie
lines.append("## 🔍 Findings\n")

categories: Dict[str, List[Finding]] = {}
for finding in report.findings:
if finding.category not in categories:
categories[finding.category] = []
categories[finding.category].append(finding)

for category, findings in categories.items():
lines.append(f"### 📁 {category} ({len(findings)})\n")

for finding in findings:
emoji = self._severity_emoji(finding.severity)
lines.append(f"#### {emoji} [{finding.severity}] {finding.title}\n")
lines.append(f"- **Fichier :** `{finding.file_path}:{finding.line_number}`\n")
lines.append(f"- **Outil :** {finding.source_tool}\n")
if finding.cve:
lines.append(f"- **CVE :** {finding.cve}\n")
lines.append(f"- **Description :** {finding.description}\n")
if finding.code_snippet:
lines.append(f"\n```\n{finding.code_snippet[:500]}\n```\n")
if finding.remediation:
lines.append(f"- **🔧 Remédiation :** {finding.remediation}\n")
if finding.reference:
lines.append(f"- **📖 Référence :** {finding.reference}\n")
lines.append("\n")

# Erreurs
if report.errors:
lines.append("## ⚠️ Erreurs d'analyse\n")
for error in report.errors:
lines.append(f"- {error}\n")

lines.append("\n---\n")
lines.append(f"*Rapport généré par NEXUS-SENTINEL v{SentinelConfig.VERSION}*\n")
lines.append(f"*Architecte : {SentinelConfig.ARCHITECTE}*\n")

with open(output_path, 'w', encoding='utf-8') as f:
f.writelines(lines)

logger.info(f"📄 Rapport Markdown : {output_path}")

