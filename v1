class DependencyAnalyzer:
"""Analyse les dépendances pour détecter les vulnérabilités."""

def __init__(self):
self.findings: List[Finding] = []

def analyze(self, repo_path: str, dep_files: List[str]) -> List[Finding]:
"""Lance l'analyse des dépendances."""
logger.info(f"📦 Analyse de {len(dep_files)} fichier(s) de dépendances...")

self.findings = []

if self._is_trivy_available():
for dep_file in dep_files:
self._run_trivy(repo_path, dep_file)
else:
logger.warning("Trivy non disponible, analyse des dépendances désactivée.")

logger.info(f"📊 Dépendances : {len(self.findings)} finding(s)")
return self.findings

def _is_trivy_available(self) -> bool:
try:
subprocess.run(["trivy", "--version"], capture_output=True, timeout=5)
return True
except (FileNotFoundError, subprocess.TimeoutExpired):
return False

def _run_trivy(self, repo_path: str, dep_file: str):
"""Lance Trivy sur un fichier de dépendances."""
try:
cmd = [
"trivy", "fs",
"--format", "json",
"--quiet",
"--scanners", "vuln",
dep_file
]

result = subprocess.run(
cmd, capture_output=True, text=True, timeout=SentinelConfig.TIMEOUT
)

if result.stdout:
data = json.loads(result.stdout)

for result_entry in data.get("Results", []):
for vuln in result_entry.get("Vulnerabilities", []):
finding = Finding(
id=f"TRIVY-{vuln.get('VulnerabilityID', 'unknown')}",
title=vuln.get("Title", vuln.get("VulnerabilityID", "Vulnérabilité")),
severity=vuln.get("Severity", "UNKNOWN"),
category="DEPENDENCY",
file_path=os.path.relpath(dep_file, repo_path),
line_number=0,
code_snippet=f"{vuln.get('PkgName', '')}: {vuln.get('InstalledVersion', '')} -> {vuln.get('FixedVersion', 'N/A')}",
description=vuln.get("Description", ""),
cve=vuln.get("VulnerabilityID", ""),
reference=vuln.get("PrimaryURL", ""),
source_tool="trivy",
remediation=f"Mettre à jour vers la version {vuln.get('FixedVersion', 'N/A')}"
)
self.findings.append(finding)

except subprocess.TimeoutExpired:
logger.warning(f"Trivy timeout sur {dep_file}")
except (json.JSONDecodeError, subprocess.CalledProcessError) as e:
logger.debug(f"Trivy erreur : {e}")

