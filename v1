class WorkflowAnalyzer:
"""Analyse les workflows GitHub Actions pour détecter les vulnérabilités."""

DANGEROUS_PATTERNS = [
{
"id": "CMD_INJECTION",
"pattern": r"\$\{\{\s*github\.event\.(issue|pull_request|comment)\.(title|body|head\.ref)",
"severity": "CRITICAL",
"description": "Injection de commandes via des données utilisateur dans un workflow"
},
{
"id": "PR_TARGET",
"pattern": r"pull_request_target",
"severity": "HIGH",
"description": "Utilisation de pull_request_target (risque de confused deputy)"
},
{
"id": "PERMISSIONS_EXCESSIVE",
"pattern": r"permissions:\s*write-all",
"severity": "HIGH",
"description": "Permissions excessives (write-all) dans un workflow"
},
{
"id": "SECRETS_IN_RUN",
"pattern": r"\$\{\{\s*secrets\.[^}]+\s*\}\}.*run:",
"severity": "HIGH",
"description": "Secrets utilisés directement dans une commande run"
}
]

def __init__(self):
self.findings: List[Finding] = []

def analyze(self, repo_path: str, workflows: List[str]) -> List[Finding]:
"""Analyse tous les workflows GitHub Actions."""
logger.info(f"⚙️ Analyse de {len(workflows)} workflow(s)...")

self.findings = []

if not YAML_AVAILABLE:
logger.warning("PyYAML non disponible, analyse des workflows désactivée.")
return self.findings

for workflow_path in workflows:
self._analyze_workflow(repo_path, workflow_path)

logger.info(f"📊 Workflows : {len(self.findings)} finding(s)")
return self.findings

def _analyze_workflow(self, repo_path: str, workflow_path: str):
"""Analyse un workflow individuel."""
try:
with open(workflow_path, 'r', encoding='utf-8') as f:
content = f.read()

rel_path = os.path.relpath(workflow_path, repo_path)

# Analyse par patterns
for rule in self.DANGEROUS_PATTERNS:
matches = re.finditer(rule["pattern"], content, re.MULTILINE)
for match in matches:
line_num = content[:match.start()].count('\n') + 1

finding = Finding(
id=f"WORKFLOW-{rule['id']}-{hashlib.md5(match.group(0).encode()).hexdigest()[:6]}",
title=f"Workflow : {rule['id']}",
severity=rule["severity"],
category="WORKFLOW",
file_path=rel_path,
line_number=line_num,
code_snippet=content[max(0, match.start()-50):min(len(content), match.end()+50)],
description=rule["description"],
source_tool="nexus-workflow-analyzer",
remediation=self._get_remediation(rule["id"])
)
self.findings.append(finding)

# Analyse structurelle
try:
workflow_data = yaml.safe_load(content)
if isinstance(workflow_data, dict):
self._analyze_structure(workflow_data, rel_path, content)
except yaml.YAMLError:
pass

except Exception as e:
logger.debug(f"Erreur analyse workflow {workflow_path} : {e}")

def _analyze_structure(self, data: Dict, rel_path: str, content: str):
"""Analyse la structure YAML du workflow."""
# Vérifier les permissions
if "permissions" not in data:
finding = Finding(
id="WORKFLOW-NO-PERMISSIONS",
title="Permissions non définies",
severity="MEDIUM",
category="WORKFLOW",
file_path=rel_path,
line_number=1,
code_snippet="",
description="Le workflow n'a pas de section 'permissions'. Par défaut, GitHub accorde des permissions larges.",
source_tool="nexus-workflow-analyzer",
remediation="Ajouter une section 'permissions: read-all' ou des permissions granulaires."
)
self.findings.append(finding)

def _get_remediation(self, rule_id: str) -> str:
remediations = {
"CMD_INJECTION": "Utiliser des variables d'environnement validées au lieu d'interpoler directement github.event dans run:.",
"PR_TARGET": "Éviter pull_request_target. Si nécessaire, ne jamais checkout le code PR et ne pas exécuter de code non fiable.",
"PERMISSIONS_EXCESSIVE": "Remplacer write-all par des permissions granulaires (contents: read, etc.).",
"SECRETS_IN_RUN": "Utiliser env: pour passer les secrets aux commandes, avec validation."
}
return remediations.get(rule_id, "Corriger selon les bonnes pratiques GitHub Actions.")

