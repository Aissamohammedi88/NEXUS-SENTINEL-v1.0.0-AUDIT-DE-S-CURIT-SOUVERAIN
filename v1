class SentinelOrchestrator:
"""Orchestrateur principal de l'audit."""

def __init__(self):
self.ingestor = Ingestor()
self.sast = SastAnalyzer()
self.workflow = WorkflowAnalyzer()
self.deps = DependencyAnalyzer()
self.crosschecker = CrossChecker()
self.report_gen = ReportGenerator()
self.db = SentinelDatabase()

def audit(self, target: str, output_format: str = "all") -> AuditReport:
"""Lance un audit complet."""
start_time = time.time()

print("\n" + "=" * 70)
print(f"🛡️ NEXUS-SENTINEL AUDIT v{SentinelConfig.VERSION}")
print(f"🎯 Cible : {target}")
print("=" * 70 + "\n")

findings: List[Finding] = []
errors: List[str] = []

try:
# Phase 1 : Ingestion
repo_path, metadata = self.ingestor.ingest(target)

# Phase 2 : Analyse SAST
findings.extend(self.sast.analyze(repo_path, metadata))

# Phase 3 : Analyse des workflows
if metadata.get("workflows"):
findings.extend(self.workflow.analyze(repo_path, metadata["workflows"]))

# Phase 4 : Analyse des dépendances
if metadata.get("dependency_files"):
findings.extend(self.deps.analyze(repo_path, metadata["dependency_files"]))

# Phase 5 : Cross-check et déduplication
findings = self.crosschecker.deduplicate(findings)
findings = self.crosschecker.prioritize(findings)

except Exception as e:
errors.append(f"Erreur critique : {str(e)}")
logger.error(traceback.format_exc())

# Calcul de la durée
duration = time.time() - start_time

# Statistiques
stats: Dict[str, int] = {}
for finding in findings:
stats[finding.severity] = stats.get(finding.severity, 0) + 1

# Construction du rapport
report = AuditReport(
target=target,
timestamp=datetime.now().isoformat(),
duration=duration,
files_analyzed=metadata.get("code_files", 0) if 'metadata' in locals() else 0,
findings=findings,
stats=stats,
errors=errors
)

# Sauvegarde en DB
try:
audit_id = self.db.save_audit(report)

# Comparaison avec l'audit précédent
previous = self.db.get_previous_audit(target)
if previous:
self._compare_with_previous(report, previous)
except Exception as e:
logger.error(f"Erreur DB : {e}")

# Génération des rapports
timestamp_str = datetime.now().strftime("%Y%m%d_%H%M%S")
base_name = f"sentinel_report_{timestamp_str}"

if output_format in ["all", "json"]:
self.report_gen.generate_json(report, os.path.join(SentinelConfig.WORKSPACE_DIR, f"{base_name}.json"))

if output_format in ["all", "md"]:
self.report_gen.generate_markdown(report, os.path.join(SentinelConfig.WORKSPACE_DIR, f"{base_name}.md"))

if output_format in ["all", "html"]:
self.report_gen.generate_html(report, os.path.join(SentinelConfig.WORKSPACE_DIR, f"{base_name}.html"))

# Affichage final
self._display_summary(report)

return report

def _compare_with_previous(self, current: AuditReport, previous: Dict):
"""Compare avec l'audit précédent pour détecter les régressions."""
previous_findings = {f["id"] for f in previous.get("findings", [])}
current_findings = {f.id for f in current.findings}

new_findings = current_findings - previous_findings
fixed_findings = previous_findings - current_findings

if new_findings:
logger.warning(f"⚠️ {len(new_findings)} nouvelle(s) régression(s) détectée(s)")
if fixed_findings:
logger.info(f"✅ {len(fixed_findings)} finding(s) corrigé(s)")

def _display_summary(self, report: AuditReport):
"""Affiche un résumé du rapport."""
print("\n" + "=" * 70)
print("📊 RÉSUMÉ DE L'AUDIT")
print("=" * 70)
print(f"🎯 Cible : {report.target}")
print(f"⏱️ Durée : {report.duration:.2f}s")
print(f"📁 Fichiers analysés : {report.files_analyzed}")
print(f"🔍 Total findings : {len(report.findings)}")
print()

if RICH_AVAILABLE and console:
table = Table(title="Findings par sévérité")
table.add_column("Sévérité", style="bold")
table.add_column("Nombre", justify="right")

for severity in ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"]:
count = report.stats.get(severity, 0)
if count > 0:
table.add_row(severity, str(count))

console.print(table)
else:
print("Findings par sévérité :")
for severity in ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"]:
count = report.stats.get(severity, 0)
if count > 0:
print(f" {severity}: {count}")

if report.errors:
print("\n⚠️ Erreurs :")
for error in report.errors:
print(f" - {error}")

print("\n" + "=" * 70)

