class SastAnalyzer:
"""Analyse statique multi-moteurs (Semgrep, Bandit)."""

def __init__(self):
self.findings: List[Finding] = []

def analyze(self, repo_path: str, metadata: Dict[str, Any]) -> List[Finding]:
"""Lance tous les analyseurs SAST."""
logger.info("🔬 Lancement de l'analyse SAST...")

self.findings = []

# Lancer chaque moteur
if self._is_tool_available("semgrep"):
self._run_semgrep(repo_path)

if "python" in metadata.get("languages", {}):
if self._is_tool_available("bandit"):
self._run_bandit(repo_path)

# Analyse custom des secrets
self._run_secret_scan(repo_path, metadata)

logger.info(f"📊 SAST : {len(self.findings)} finding(s) détecté(s)")
return self.findings

def _is_tool_available(self, tool: str) -> bool:
try:
subprocess.run([tool, "--version"], capture_output=True, timeout=5)
return True
except (FileNotFoundError, subprocess.TimeoutExpired):
logger.warning(f"Outil non disponible : {tool}")
return False

def _run_semgrep(self, repo_path: str):
"""Lance Semgrep avec les règles de sécurité."""
logger.info(" → Semgrep en cours...")

try:
cmd = [
"semgrep", "scan",
"--config=auto",
"--json",
"--quiet",
"--timeout=30",
repo_path
]

result = subprocess.run(
cmd, capture_output=True, text=True, timeout=SentinelConfig.TIMEOUT
)

if result.stdout:
data = json.loads(result.stdout)
for issue in data.get("results", []):
finding = Finding(
id=f"SEMGREP-{issue.get('check_id', 'unknown')}",
title=issue.get("check_id", "Semgrep Issue"),
severity=self._map_semgrep_severity(issue.get("extra", {}).get("severity", "INFO")),
category="SAST",
file_path=issue.get("path", ""),
line_number=issue.get("start", {}).get("line", 0),
code_snippet=issue.get("extra", {}).get("lines", ""),
description=issue.get("extra", {}).get("message", ""),
reference=issue.get("extra", {}).get("metadata", {}).get("source", ""),
source_tool="semgrep",
remediation="Corriger selon les recommandations de la règle."
)
self.findings.append(finding)
except subprocess.TimeoutExpired:
logger.warning("Semgrep : timeout dépassé")
except (json.JSONDecodeError, subprocess.CalledProcessError) as e:
logger.debug(f"Semgrep erreur : {e}")

def _map_semgrep_severity(self, severity: str) -> str:
mapping = {"ERROR": "HIGH", "WARNING": "MEDIUM", "INFO": "LOW"}
return mapping.get(severity.upper(), "MEDIUM")

def _run_bandit(self, repo_path: str):
"""Lance Bandit sur le code Python."""
logger.info(" → Bandit en cours...")

try:
cmd = [
"bandit", "-r", repo_path,
"-f", "json",
"-ll"
]

result = subprocess.run(
cmd, capture_output=True, text=True, timeout=SentinelConfig.TIMEOUT
)

if result.stdout:
data = json.loads(result.stdout)
for issue in data.get("results", []):
finding = Finding(
id=f"BANDIT-{issue.get('test_id', 'unknown')}",
title=issue.get("test_name", "Bandit Issue"),
severity=self._map_bandit_severity(issue.get("issue_severity", "LOW")),
category="SAST",
file_path=issue.get("filename", ""),
line_number=issue.get("line_number", 0),
code_snippet=issue.get("code", ""),
description=issue.get("issue_text", ""),
source_tool="bandit",
remediation="Corriger selon les recommandations Bandit."
)
self.findings.append(finding)
except subprocess.TimeoutExpired:
logger.warning("Bandit : timeout")
except (json.JSONDecodeError, subprocess.CalledProcessError) as e:
logger.debug(f"Bandit erreur : {e}")

def _map_bandit_severity(self, severity: str) -> str:
mapping = {"HIGH": "HIGH", "MEDIUM": "MEDIUM", "LOW": "LOW"}
return mapping.get(severity.upper(), "MEDIUM")

def _run_secret_scan(self, repo_path: str, metadata: Dict[str, Any]):
"""Scan des secrets basé sur les patterns."""
logger.info(" → Scan des secrets...")

count = 0

for root, dirs, files in os.walk(repo_path):
dirs[:] = [d for d in dirs if d not in [
'.git', 'node_modules', 'venv', '__pycache__', 'dist', 'build'
]]

for file in files:
file_path = os.path.join(root, file)
ext = os.path.splitext(file)[1].lower()

if ext not in SentinelConfig.CODE_EXTENSIONS:
continue

try:
if os.path.getsize(file_path) > SentinelConfig.MAX_FILE_SIZE:
continue

with open(file_path, 'r', encoding='utf-8', errors='ignore') as f:
content = f.read()

for secret_type, pattern in SentinelConfig.SECRET_PATTERNS.items():
matches = re.finditer(pattern, content)
for match in matches:
line_num = content[:match.start()].count('\n') + 1

finding = Finding(
id=f"SECRET-{secret_type}-{hashlib.md5(match.group(0).encode()).hexdigest()[:8]}",
title=f"Secret détecté : {secret_type}",
severity="CRITICAL",
category="SECRET",
file_path=os.path.relpath(file_path, repo_path),
line_number=line_num,
code_snippet=match.group(0)[:100] + "...",
description=f"Pattern de secret détecté : {secret_type}",
source_tool="nexus-secret-scan",
remediation="Supprimer le secret du code, utiliser des variables d'environnement, révoquer le secret."
)
self.findings.append(finding)
count += 1
except Exception as e:
logger.debug(f"Erreur scan {file_path} : {e}")

if count > 0:
logger.warning(f"⚠️ {count} secret(s) potentiel(s) détecté(s)")

