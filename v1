class SentinelDatabase:
"""Gère la persistance des audits dans SQLite."""

def __init__(self, db_path: str = SentinelConfig.DB_PATH):
self.db_path = db_path
self.conn = None
self._init_db()

def _init_db(self):
"""Initialise le schéma."""
try:
self.conn = sqlite3.connect(self.db_path)
cursor = self.conn.cursor()

cursor.execute("""
CREATE TABLE IF NOT EXISTS audits (
id INTEGER PRIMARY KEY AUTOINCREMENT,
target TEXT NOT NULL,
timestamp TEXT NOT NULL,
duration REAL,
files_analyzed INTEGER,
total_findings INTEGER,
critical_count INTEGER,
high_count INTEGER,
medium_count INTEGER,
low_count INTEGER,
report_json TEXT
)
""")

cursor.execute("""
CREATE TABLE IF NOT EXISTS findings (
id INTEGER PRIMARY KEY AUTOINCREMENT,
audit_id INTEGER,
finding_id TEXT,
title TEXT,
severity TEXT,
category TEXT,
file_path TEXT,
line_number INTEGER,
cve TEXT,
source_tool TEXT,
FOREIGN KEY (audit_id) REFERENCES audits(id)
)
""")

self.conn.commit()
logger.debug(f"Base de données initialisée : {self.db_path}")
except sqlite3.Error as e:
logger.error(f"Erreur DB : {e}")

def save_audit(self, report: AuditReport) -> int:
"""Sauvegarde un audit complet."""
if not self.conn:
return -1

cursor = self.conn.cursor()

stats = report.stats
cursor.execute("""
INSERT INTO audits (target, timestamp, duration, files_analyzed,
total_findings, critical_count, high_count, medium_count, low_count, report_json)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
""", (
report.target, report.timestamp, report.duration, report.files_analyzed,
len(report.findings),
stats.get("CRITICAL", 0), stats.get("HIGH", 0),
stats.get("MEDIUM", 0), stats.get("LOW", 0),
json.dumps(report.to_dict())
))

audit_id = cursor.lastrowid

for finding in report.findings:
cursor.execute("""
INSERT INTO findings (audit_id, finding_id, title, severity, category, file_path, line_number, cve, source_tool)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
""", (
audit_id, finding.id, finding.title, finding.severity, finding.category,
finding.file_path, finding.line_number, finding.cve, finding.source_tool
))

self.conn.commit()
logger.info(f"Audit sauvegardé en DB (ID: {audit_id})")
return audit_id

def get_previous_audit(self, target: str) -> Optional[Dict]:
"""Récupère le dernier audit pour un target donné."""
if not self.conn:
return None

cursor = self.conn.cursor()
cursor.execute("""
SELECT report_json FROM audits
WHERE target = ?
ORDER BY timestamp DESC LIMIT 1
""", (target,))

row = cursor.fetchone()
if row:
return json.loads(row[0])
return None

def close(self):
if self.conn:
self.conn.close()

