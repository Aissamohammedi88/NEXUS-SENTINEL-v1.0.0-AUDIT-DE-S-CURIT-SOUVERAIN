def main():
parser = argparse.ArgumentParser(
description=f"NEXUS-SENTINEL v{SentinelConfig.VERSION} — Audit de sécurité souverain",
formatter_class=argparse.RawDescriptionHelpFormatter,
epilog="""
Exemples :
python nexus_sentinel.py audit https://github.com/user/repo
python nexus_sentinel.py audit ./mon-projet --format md
python nexus_sentinel.py scan ./mon-projet --sast-only
python nexus_sentinel.py history --target https://github.com/user/repo
"""
)

subparsers = parser.add_subparsers(dest="command", help="Commande à exécuter")

# Commande : audit complet
audit_parser = subparsers.add_parser("audit", help="Audit complet d'un dépôt")
audit_parser.add_argument("target", help="URL ou chemin du dépôt")
audit_parser.add_argument("--format", choices=["all", "json", "md", "html"], default="all",
help="Format de sortie (défaut: all)")

# Commande : scan rapide
scan_parser = subparsers.add_parser("scan", help="Scan rapide (SAST uniquement)")
scan_parser.add_argument("target", help="URL ou chemin du dépôt")
scan_parser.add_argument("--sast-only", action="store_true", help="SAST uniquement")

# Commande : historique
history_parser = subparsers.add_parser("history", help="Historique des audits")
history_parser.add_argument("--target", help="Filtrer par cible")

# Commande : setup
subparsers.add_parser("setup", help="Installer les dépendances")

args = parser.parse_args()

if not args.command:
parser.print_help()
return

# Installation des dépendances
install_system_dependencies()
install_python_dependencies()

# Orchestrateur
orchestrator = SentinelOrchestrator()

if args.command == "audit":
orchestrator.audit(args.target, args.format)

elif args.command == "scan":
# Scan rapide
logger.info("Scan rapide...")
repo_path, metadata = orchestrator.ingestor.ingest(args.target)
findings = orchestrator.sast.analyze(repo_path, metadata)

print(f"\n📊 {len(findings)} finding(s) détecté(s)")
for finding in findings[:10]: # Top 10
