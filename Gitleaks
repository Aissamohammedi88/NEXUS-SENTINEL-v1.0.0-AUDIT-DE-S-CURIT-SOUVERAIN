def _run_gitleaks(self, repo_path: str):
    """Lance Gitleaks pour la détection de secrets."""
    if not self._is_tool_available("gitleaks"):
        logger.warning("Gitleaks non disponible, fallback sur scan custom.")
        return self._run_secret_scan(repo_path, {})

    cmd = [
        "gitleaks", "detect",
        "--source", repo_path,
        "--report-format", "json",
        "--report-path", "/tmp/gitleaks-report.json",
        "--no-git", "--redact", "--verbose"
    ]
    
    try:
        subprocess.run(cmd, capture_output=True, timeout=SentinelConfig.TIMEOUT)
        with open("/tmp/gitleaks-report.json") as f:
            data = json.load(f)
        for leak in data:
            finding = Finding(
                id=f"GITLEAKS-{hashlib.md5(leak.get('Secret', '').encode()).hexdigest()[:8]}",
                title=f"Secret détecté : {leak.get('RuleID', 'unknown')}",
                severity="CRITICAL",
                category="SECRET",
                file_path=leak.get("File", ""),
                line_number=leak.get("StartLine", 0),
                code_snippet=leak.get("Secret", "")[:100],
                description=leak.get("Description", ""),
                source_tool="gitleaks",
                remediation="Révoquer le secret, retirer du code, utiliser un vault."
            )
            self.findings.append(finding)
    except Exception as e:
        logger.debug(f"Gitleaks erreur : {e}")
